# ==============================================================================
# M&A Due Diligence Intelligence Engine — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- LLM API Keys ---
# Free-tier Gemini quotas are per API key, so adding keys multiplies capacity.
# The engine drains one key's quota on a given model before moving to the next
# key on the SAME model, and only steps down to a weaker model once every key is
# spent — so answer quality degrades last, not first.
#
# Use any one of these three forms (checked in this order):
GEMINI_API_KEYS=key_one,key_two,key_three
# GEMINI_API_KEY_1=key_one
# GEMINI_API_KEY_2=key_two
# GEMINI_API_KEY=your_gemini_api_key_here      # single-key / legacy
#
# Order matters: key 1 is spent first. With no key set, every agent runs on the
# local Ollama model and the pipeline still works.

# --- Verification agents (Agents 4 and 8) ---
# "cloud" (default) routes verification through the Gemini ladder — better
# structured reasoning, and no local GPU needed. "local" pins it to Ollama,
# which keeps verification off the metered quota entirely.
VERIFICATION_BACKEND=cloud

# --- Database ---
POSTGRES_URL=postgresql://manda_user:your_password_here@localhost:5432/manda_rag
POSTGRES_PASSWORD=your_password_here

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_PORT=6334

# --- Ollama (Local LLM Fallback) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_KEEP_ALIVE=60m
OLLAMA_NUM_GPU=1

# --- Application Settings ---
LOG_LEVEL=INFO
ENVIRONMENT=development

# Directory for the immutable audit log (every query and ingestion is recorded).
AUDIT_LOG_DIR=./logs/audit

# --- Public demo guardrails (api/security.py) ---
# Admin key, sent as the X-Admin-Key header. Lifts every limit and is required to
# delete or write non-sandbox deals. Unset: admin is implied only when
# ENVIRONMENT=development (so the local UI and eval harness keep working).
# ADMIN_API_KEY=
# Take the client IP from X-Forwarded-For's first hop. Only set behind a proxy.
TRUST_PROXY_HEADERS=0
# Per-client-IP query limits (/query and /query/stream). 0 disables a limit.
RATE_LIMIT_QUERY_PER_MINUTE=5
RATE_LIMIT_QUERY_PER_DAY=50
# Per-client-IP upload limits (/ingest). 0 disables a limit.
RATE_LIMIT_INGEST_PER_MINUTE=3
RATE_LIMIT_INGEST_PER_DAY=20
# Pipeline runs allowed at once; extra requests get an immediate 503, not a queue.
MAX_CONCURRENT_PIPELINES=2
# Queries per UTC day across all public callers — last-resort Gemini quota guard.
DAILY_QUERY_CAP=300

# Base URL the Streamlit UI uses to reach the API. docker-compose injects
# http://api:8000 (the service DNS name); leave unset for a bare-metal run and
# it defaults to localhost.
# API_URL=http://localhost:8000
