# Environment for the free-tier deployment.
#
# Copy the backend block into the Hugging Face Space's Settings → Variables and
# secrets. Anything holding a credential goes in "Secrets"; the rest in
# "Variables". The frontend block goes into Vercel's project environment.
#
# This file is an example and must never hold real values — .dockerignore
# excludes .env* from the image so keys reach the container through the
# platform's own secret store rather than a baked layer.

# =============================================================================
# Backend — Hugging Face Space (Docker SDK, free CPU tier)
# =============================================================================

# --- Vector store: Qdrant Cloud free tier (1GB, free forever) ---------------
# From the cluster's "Connect" panel. The URL includes the port.
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
# SECRET. Its presence is also what tells the client this is a managed cluster,
# which switches the transport from gRPC to REST — see src/vector_db/qdrant_client.py.
QDRANT_API_KEY=

# --- Postgres: Neon free tier ----------------------------------------------
# Budget tracking and LangGraph checkpoints. SECRET.
# Optional: without it both degrade to in-memory, which loses daily quota
# accounting across restarts but keeps the pipeline fully functional.
POSTGRES_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- LLM: Gemini free tier --------------------------------------------------
# SECRET. Comma-separated. Keys multiply daily capacity, and rotation drains one
# key on a model before stepping down a rung — see the model routing section of
# the README.
GEMINI_API_KEYS=

# --- Retrieval profile for CPU hosting --------------------------------------
# Measured on 2 vCPU (this tier): bge-reranker-v2-m3 scores 40 passages in 111s,
# and a decomposed query reranks four times — about 7.5 minutes per question.
# The MiniLM cross-encoder does the same work in 3.2s, a 34x difference, at the
# cost of being English-only.
#
# The embedding model is deliberately NOT changed. It costs 0.12s per query, and
# swapping it would invalidate every vector already in Qdrant.
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_LENGTH=512

# --- Measurement only: pin the synthesis model ------------------------------
# Leave UNSET in production. Recall on the golden set is dominated by which model
# answered — measured within one run, on one index with identical retrieval, mean
# recall ran 100% on gemini-3.6-flash down to 50% on gemini-2.5-flash. The ladder
# picks by availability, and Google's 503 "high demand" responses move that hour
# to hour, so two eval runs are not comparable unless the model is held fixed.
#
# Set this to the SAME value for the local and deployed eval runs, so the only
# thing differing between them is the reranker.
# SYNTHESIS_MODEL_PIN=gemini/gemini-3.7-flash
# SYNTHESIS_PIN_MAX_WAIT_SECONDS=1800

# Load models during startup rather than on the first query, so the visitor who
# wakes a sleeping Space does not also pay the model load.
WARM_MODELS=1

# --- CORS -------------------------------------------------------------------
# The frontend's origin. Comma-separated, no trailing slash. Without this the
# browser blocks every request and the UI shows an empty deal list with no error
# in the server log — the failure is entirely client-side.
CORS_ORIGINS=https://your-project.vercel.app

# --- Ephemeral visitor uploads ----------------------------------------------
# How long a sandbox deal survives if the browser's tab-close beacon never
# arrives. The beacon is the fast path; this sweep is the actual guarantee.
SANDBOX_TTL_SECONDS=7200
SANDBOX_SWEEP_INTERVAL_SECONDS=300

# =============================================================================
# Frontend — Vercel
# =============================================================================
# Read at build time and inlined into the client bundle, so it must be set
# before the build, and a change to it requires a redeploy rather than a
# restart. No trailing slash.
NEXT_PUBLIC_API_URL=https://your-name-your-space.hf.space
