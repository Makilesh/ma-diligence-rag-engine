# Environment for the public deployment.
#
# Backend: copy the backend block to `.env` in the repository root ON THE SERVER,
# next to docker-compose.prod.yml. Compose reads it for both variable
# substitution and the api container's environment. Frontend: the last block
# goes into Vercel's project environment.
#
# This file is an example and must never hold real values — .dockerignore
# excludes .env* from the image, so secrets reach the container at runtime and
# never sit in a built layer.

# =============================================================================
# Backend — single Linux VM (docker-compose.prod.yml + Caddy)
# =============================================================================

# --- Public address ---------------------------------------------------------
# The hostname Caddy requests a TLS certificate for. It must resolve to this
# server's public IP (not your home connection) before `up`, and ports 80/443
# must be open in both the cloud firewall and the host's.
DOMAIN=redline-dd.duckdns.org

# --- Datastores (run on the same VM) ----------------------------------------
# SECRET. Postgres holds quota accounting and LangGraph checkpoints; Qdrant and
# Postgres are reachable only on the compose network, and QDRANT_URL /
# POSTGRES_URL are set by docker-compose.prod.yml from this password.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- LLM: Gemini free tier --------------------------------------------------
# SECRET. Comma-separated. Keys multiply daily capacity, and rotation drains one
# key on a model before stepping down a rung — see the model routing section of
# the README.
GEMINI_API_KEYS=

# --- Retrieval profile for CPU hosting --------------------------------------
# Measured on 2 vCPU: bge-reranker-v2-m3 scores 40 passages in 111s,
# and a decomposed query reranks four times — about 7.5 minutes per question.
# The MiniLM cross-encoder does the same work in 3.2s, a 34x difference, at the
# cost of being English-only.
#
# The embedding model is deliberately NOT changed. It costs 0.12s per query, and
# swapping it would invalidate every vector already in Qdrant.
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MAX_LENGTH=512

# --- Measurement only: pin the synthesis model ------------------------------
# Leave UNSET in production. Recall on the golden set is dominated by which model
# answered — measured within one run, on one index with identical retrieval, mean
# recall ran 100% on gemini-3.6-flash down to 50% on gemini-2.5-flash. The ladder
# picks by availability, and Google's 503 "high demand" responses move that hour
# to hour, so two eval runs are not comparable unless the model is held fixed.
#
# Set this to the SAME value for the local and deployed eval runs, so the only
# thing differing between them is the reranker.
# SYNTHESIS_MODEL_PIN=gemini/gemini-3.7-flash
# SYNTHESIS_PIN_MAX_WAIT_SECONDS=1800

# --- CORS -------------------------------------------------------------------
# The frontend's origin. Comma-separated, no trailing slash. Without this the
# browser blocks every request and the UI shows an empty deal list with no error
# in the server log — the failure is entirely client-side.
CORS_ORIGINS=https://redline-silk-nine.vercel.app

# --- Ephemeral visitor uploads ----------------------------------------------
# How long a sandbox deal survives if the browser's tab-close beacon never
# arrives. The beacon is the fast path; this sweep is the actual guarantee.
SANDBOX_TTL_SECONDS=7200
SANDBOX_SWEEP_INTERVAL_SECONDS=300

# --- Public demo guardrails (api/security.py) ------------------------------
# SECRET, required. Sent as X-Admin-Key; lifts limits and is the only way to
# delete or write non-sandbox deals (e.g. seeding the demo corpus).
ADMIN_API_KEY=
# docker-compose.prod.yml sets TRUST_PROXY_HEADERS=1 and ENVIRONMENT=production
# itself: Caddy overwrites X-Forwarded-For with the address it saw, so the first
# hop is the real visitor.
# Per-client-IP query limits (/query and /query/stream). 0 disables a limit.
RATE_LIMIT_QUERY_PER_MINUTE=5
RATE_LIMIT_QUERY_PER_DAY=50
# Per-client-IP upload limits (/ingest). 0 disables a limit.
RATE_LIMIT_INGEST_PER_MINUTE=3
RATE_LIMIT_INGEST_PER_DAY=20
# Pipeline runs allowed at once on 2 cores; the rest get an immediate 503.
MAX_CONCURRENT_PIPELINES=2
# Public queries per UTC day across all visitors — last-resort Gemini quota guard.
DAILY_QUERY_CAP=300

# =============================================================================
# Frontend — Vercel
# =============================================================================
# Read at build time and inlined into the client bundle, so it must be set
# before the build, and a change to it requires a redeploy rather than a
# restart. No trailing slash.
NEXT_PUBLIC_API_URL=https://redline-dd.duckdns.org
# Show the PII toggle in the ask bar. Off for the public demo: the server ignores
# include_pii from non-admin callers anyway, so the toggle would only mislead.
# NEXT_PUBLIC_ENABLE_PII_TOGGLE=1
