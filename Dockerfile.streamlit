# Dockerfile for Streamlit UI
FROM python:3.11-slim

WORKDIR /app

# Install dependencies — pinned to the same ranges as requirements.txt so the
# UI image is reproducible and cannot drift onto a Streamlit 2.x breaking change.
RUN pip install --no-cache-dir "streamlit>=1.35.0,<2.0.0" "requests>=2.31.0,<3.0.0"

# Copy application code
COPY app/ ./app/

# Expose port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "app/streamlit_app.py", "--server.port", "8501", "--server.address", "0.0.0.0", "--server.headless", "true"]
